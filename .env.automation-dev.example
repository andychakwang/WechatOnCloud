# Copy to .env.automation-dev for local source-built automation development.
# Do not commit the copied file: it may contain panel passwords and Bridge tokens.

WOC_DEV_PROJECT=woc-automation-dev
WOC_DEV_IMAGE_PREFIX=woc-dev
WOC_DEV_VERSION=automation-dev
WOC_DEV_PANEL_CONTAINER=woc-panel-automation-dev
WOC_DEV_HTTP_PORT=36082

# First admin account for this isolated dev panel data directory.
WOC_DEV_USER=admin
WOC_DEV_PASSWORD=wechat

WOC_PUID=1000
WOC_PGID=1000
WOC_TZ=Asia/Shanghai

# Add your public dev host if you reverse-proxy or port-forward this panel.
PANEL_ALLOWED_HOSTS=localhost,127.0.0.1,nasbot.cloud

# Optional OpenAI-compatible AI draft provider.
AUTOMATION_AI_API_KEY=
AUTOMATION_AI_BASE_URL=
AUTOMATION_AI_MODEL=

# Optional token for Mac 企业微信 Bridge/Runner access.
# Use at least 16 random characters before exposing the dev panel outside LAN.
AUTOMATION_BRIDGE_TOKEN=

# Instance defaults inherited by containers created from the dev panel.
WOC_VIDEO_DEVICES=
WOC_ENABLE_GPU=
WOC_INSTANCE_MEM_GB=
WOC_INSTANCE_MEM_SOFT_MB=1500
WOC_INSTANCE_MEM_HARD_MB=2500
WOC_WATCHDOG_INTERVAL_SEC=300
WOC_SPOOF_OS=1
